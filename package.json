{
    "name": "html-dialog",
    "version": "0.0.10",
    "description": "A tiny, dependency-free wrapper around the native HTML <dialog> element",
    "type": "module",
    "main": "./dist/html-dialog.js",
    "module": "./dist/html-dialog.js",
    "types": "./dist/index.d.ts",
    "unpkg": "./dist/html-dialog.iife.js",
    "jsdelivr": "./dist/html-dialog.iife.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/html-dialog.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "dev": "vite demo",
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "typecheck": "tsc",
        "size": "size-limit",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/alexwenzel/npm-html-dialog.git"
    },
    "keywords": [
        "html",
        "dialog",
        "modal",
        "vanilla",
        "typescript"
    ],
    "author": "alexwenzel <alex@w3entwickler.de>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/alexwenzel/npm-html-dialog/issues"
    },
    "homepage": "https://github.com/alexwenzel/npm-html-dialog#readme",
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@size-limit/preset-small-lib": "^14.3.0",
        "@vitest/browser-playwright": "^5.1.0",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "playwright": "^1.65.0",
        "prettier": "^3.9.10",
        "publint": "^0.3.25",
        "size-limit": "^14.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
